# Settings for one computer. Copy this file to .env and set the values.
# .env is not in git. Do not commit it. Use shell syntax. Put a value in single
# quotes if it has special characters.

# Linux only: the Mac that builds the iOS app, as user@host. Passwordless ssh
# (a key) must work to this host. A Mac does not need this.
IOS_HOST=user@mac.example.com

# Optional: options for ssh and rsync, for example '-i ~/.ssh/mac_key -p 2222'.
#IOS_SSH_OPTS=

# Optional: the directory for the repository copy on the Mac, relative to the
# home directory of the user. The default is Developer/phone-golf.
#IOS_REMOTE_PATH=Developer/phone-golf

# The login password of the Mac user. `make ios-device` uses it to unlock the
# keychain of the Mac, so that the build can sign the app over ssh. Linux only.
# `make ios-check` tests the password.
IOS_KEYCHAIN_PASSWORD='the password'

# Optional: the simulator for `make ios-sim`. The default is iPhone 17.
#IOS_SIM=iPhone 17

# Optional: the identifier of the iPhone for `make ios-device`. Without it, the
# build uses the one connected iPhone.
#IOS_DEVICE=

# Optional: the home server for `make homelab-deploy`, as user@host, and the
# address of the API on that server for `make android-install-home`.
#HOMELAB_HOST=user@server.example.com
#GOLF_URL=https://golf.example.com
